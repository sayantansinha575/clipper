# GEMINI_API_KEY: Optional when AI_PROVIDER=ollama_only; required for Gemini cloud AI calls.
# On AI Studio this is injected automatically from Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: gemini_with_ollama_fallback | ollama_only | gemini_only
AI_PROVIDER="gemini_with_ollama_fallback"

# Local/Remote Ollama LLM fallback or primary (e.g. another VM over private VPC IP or SSH tunnel)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.5:4b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STORAGE_ROOT: Base directory for uploads, clips, subtitles, output, temp, and logs
STORAGE_ROOT="./storage"

# MAX_UPLOAD_MB: Maximum allowed source video upload size in MB
MAX_UPLOAD_MB="2048"

# MIN_FREE_DISK_MB: Minimum free disk space required before starting a render job
MIN_FREE_DISK_MB="1024"

# ADMIN_API_KEY: Optional API key required for administrative mutations if set
ADMIN_API_KEY=""

# ALLOWED_ORIGINS: Comma-separated CORS origins (empty allows same-origin)
ALLOWED_ORIGINS=""
