# AI Routing: gemini_with_ollama_fallback | ollama_only | gemini_only
AI_PROVIDER=gemini_with_ollama_fallback

# Gemini API Key (optional when AI_PROVIDER=ollama_only; free tier works with Ollama fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Local or Remote Ollama VM (e.g., private GCP VPC IP or SSH-tunneled localhost)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# CPU-optimized faster-whisper configuration for e2-standard-4 (4 vCPU / 16 GB RAM, AMD Rome)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Storage directories
STORAGE_ROOT=/opt/ai-shorts-studio/storage
MAX_UPLOAD_MB=2048
MIN_FREE_DISK_MB=1024
RETENTION_DAYS=14

# Server & Security
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_API_KEY=
